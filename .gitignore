# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Automatically generated (also verify with .swiftpm, project outputs)
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store

# Local voice test data. Recordings used for manual verification stay on the
# machine that made them: audio is never committed, and consent to record does
# not extend to publishing it in a repository. Anchored to the repository root
# so a source directory named `data/` elsewhere is unaffected.
/data/

# Release packaging output and its isolated DerivedData. Build artifacts are
# published on GitHub Releases, never committed: a binary in the history is
# unreviewable, bloats every clone, and cannot be verified after the fact.
/dist/
/.build/

# Project-local Task Master CLI dependency. The pinned manifest and lockfile
# are reviewed; downloaded packages stay local to each developer machine.
/tools/task-master/node_modules/

# Task Master renders these Markdown files from the tracked tasks.json graph.
/.taskmaster/tasks/task_*.md

# Local credentials. Never committed in any form — a key in history stays in
# history even after the file is deleted.
.env
.env.*
*.pem
*.p12
*.key
.haena-*key*

# Test results and editor state
*.xcresult
*.xctestrun
.swiftpm/

# macOS
.AppleDouble
.LSOverride
._*

# Temporary patches and scratch output
*.orig
*.rej
*.patch.tmp
